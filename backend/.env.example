# "production" enables strict CORS and requires the NLTK corpus to be
# pre-installed in the image. Anything else is treated as development.
ENV=development

# Comma-separated list of allowed browser origins. Required when ENV=production.
# Example: https://stockportfolio.vercel.app,https://www.yourdomain.com
FRONTEND_ORIGIN=

# Where the VADER lexicon lives. Set by the Dockerfile; override only if you
# install NLTK data somewhere else.
NLTK_DATA=/usr/local/share/nltk_data

# Injected by Render at runtime — do NOT set this in the dashboard.
# PORT=8001
