# "production" enables strict CORS and requires the NLTK corpus to be
# pre-installed in the image. Anything else is treated as development.
ENV=development

# Comma-separated list of allowed browser origins. Required when ENV=production.
# Example: https://stockportfolio.vercel.app,https://www.yourdomain.com
FRONTEND_ORIGIN=

# Regex matching Vercel branch-preview origins, which get a fresh subdomain per
# deploy and so cannot be listed. Scope it to this project's own subdomains
# rather than all of *.vercel.app. Optional; previews just break without it.
# Example: https://stockportfolio-[a-z0-9-]+\.vercel\.app
PREVIEW_ORIGIN_REGEX=

# Where the VADER lexicon lives. Set by the Dockerfile; override only if you
# install NLTK data somewhere else.
NLTK_DATA=/usr/local/share/nltk_data

# Injected by Render at runtime — do NOT set this in the dashboard.
# PORT=8001

# Fyers API v3 credentials, from https://myapi.fyers.in/dashboard.
# FYERS_REDIRECT_URI must exactly match the one registered on the app.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=

# LOCAL DEVELOPMENT ONLY — leave both blank in production.
#
# In production each browser holds its own token and sends it as X-Fyers-Token,
# so the server never stores one. Setting these on the server would hand every
# visitor the same broker session. The OAuth callback writes them here
# automatically when ENV is not "production", purely so a restart during local
# work does not force another login.
#
# The access token expires ~6am IST daily. The refresh token lasts 15 days but
# needs the account PIN to redeem, so it is stored and left unused.
FYERS_ACCESS_TOKEN=
FYERS_REFRESH_TOKEN=

# --- Persistence and scheduling (docker-compose provides both locally) ------
#
# Postgres. Unset means every persistence-backed route answers 503 with a
# reason rather than failing obscurely; the stateless analysis paths are
# untouched either way.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/stockportfolio

# Redis. Optional coordinator, not a cache (market data stays in-process).
# It holds the APScheduler job store, so the schedule survives a restart, and
# the per-job lock that stops the api and worker containers double-firing.
# REDIS_URL=redis://redis:6379/0

# The nightly scheduler is off unless this is true. In the compose stack only
# the worker container sets it; the api serves requests.
ENABLE_SCHEDULER=false
SCHEDULER_TIMEZONE=Asia/Kolkata

# Fernet key encrypting stored broker tokens. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# No key means token storage is refused outright rather than kept in plaintext.
TOKEN_ENCRYPTION_KEY=

# Shared secret for /api/admin/* (sent as X-Admin-Token). Unset disables those
# routes entirely, which is the right default for a public deployment.
ADMIN_TOKEN=

# Optional AI narrative layer. Without it the memo reports available:false and
# the deterministic engines are untouched.
ANTHROPIC_API_KEY=

# Optional alert delivery. Unset channels are skipped, not errors.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
